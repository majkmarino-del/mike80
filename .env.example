# Получите токен у @BotFather в Telegram и вставьте его сюда
BOT_TOKEN=your_telegram_bot_token_here

# Канал, подписка на который ОБЯЗАТЕЛЬНА для использования бота.
# Бот должен быть добавлен в этот канал как администратор,
# иначе он не сможет проверять статус подписки.
#
# Формат:
#   - публичный канал: @your_channel_username
#   - приватный канал: -1001234567890 (числовой ID, начинается с -100)
REQUIRED_CHANNEL=@your_channel_username

# Опционально: ссылка на канал для кнопки «Перейти к каналу».
# Нужно задать для приватных каналов (invite-ссылка вида https://t.me/+abc...).
# Для публичных каналов (@username) ссылка строится автоматически.
REQUIRED_CHANNEL_URL=

# Уровень логирования (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
